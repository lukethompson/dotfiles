#!/bin/bash

# =====================================
#  Shell
# =====================================
# zsh, not $SHELL: on Debian the login shell may still be bash.
alias reload="exec zsh"

# =====================================
#  ls
# =====================================
if [[ $OSTYPE == darwin* ]]; then
  alias ls="ls -G"
else
  alias ls="ls --color=auto"
fi

# =====================================
#  crontab
# =====================================
# macOS's crontab -e runs $EDITOR as a single program name, so the
# "code --wait" set in .zshrc fails with "No such file or directory".
if [[ $OSTYPE == darwin* ]]; then
  alias crontab="EDITOR=nano VISUAL=nano crontab"
fi
